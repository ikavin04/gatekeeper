# Copy to .env for local Docker Compose. Never commit real production secrets.
POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=replace-with-a-long-local-password
JWT_SECRET_KEY=replace-with-a-long-random-secret

# For an existing PostgreSQL installation instead of the Compose database:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_DB=gatekeeper
# DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/gatekeeper
